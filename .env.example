# ===================================
# TracePath Environment Configuration
# ===================================
# Copy this file and rename to .env in each folder
# NEVER commit the actual .env files to git!

# ===================================
# WALLET CONFIGURATION
# ===================================
WALLET_ADDRESS=0x533Ba0edf1d118aF4c9B7934c6fa882eE18B0e8a
PRIVATE_KEY=your_private_key_here_starts_with_0x

# ===================================
# BLOCKCHAIN NETWORK
# ===================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
NETWORK=sepolia

# ===================================
# SMART CONTRACT (Fill after deployment)
# ===================================
CONTRACT_ADDRESS=0x_will_be_filled_after_deployment

# ===================================
# BACKEND SERVER
# ===================================
PORT=5000
NODE_ENV=development
DATABASE_PATH=./db/tracepath.db

# ===================================
# FRONTEND
# ===================================
VITE_CONTRACT_ADDRESS=0x_same_as_contract_address_above
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
VITE_API_URL=http://localhost:5000
